# Cadena de conexión de Neon. La escribe `npx neon@latest init` en .env
# Sin esta variable el juego funciona igual, pero solo en memoria:
# un reinicio del servidor se lleva las partidas en curso.
DATABASE_URL=

# URL pública de la aplicación, sin barra final. Permite generar URLs absolutas
# correctas en Open Graph aun cuando el proxy no reenvíe el host o protocolo.
# PUBLIC_URL=https://bingo.ejemplo.com

# Puerto (opcional). Railway y Render lo inyectan solos.
# PORT=3000
